<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PUENTE - Tu asistente de ayuda</title>
  <style>
    :root {
      --azul: #1f4e79;
      --azul-oscuro: #173b5c;
      --azul-claro: #eaf3ff;
      --fondo: #f5f5f5;
      --blanco: #ffffff;
      --gris-fondo: #eef1f5;
      --gris-texto: #425266;
      --verde: #32b76d;
      --sombra: 0 18px 40px rgba(18, 39, 63, 0.18);
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
      background: var(--fondo);
      color: #1f2a37;
    }

    .contenedor {
      width: 100%;
      max-width: 1400px;
      margin: 0 auto;
    }

    header {
      padding: 18px 16px;
      background: linear-gradient(135deg, var(--azul), #2a5e8c);
      color: white;
      box-shadow: 0 6px 16px rgba(31, 78, 121, 0.18);
    }

    header h1 {
      margin: 0;
      font-size: clamp(1.5rem, 3vw, 2.2rem);
      font-weight: 700;
    }

    .subtitulo {
      margin-top: 6px;
      font-size: 1rem;
      opacity: 0.95;
    }

    .selector-regional {
      display: flex;
      flex-wrap: wrap;
      gap: 16px;
      padding: 20px;
      background: white;
      border-bottom: 1px solid #e3e8ef;
    }

    .selector-regional label {
      display: block;
      margin-bottom: 8px;
      color: var(--gris-texto);
      font-weight: 700;
      font-size: 0.95rem;
    }

    .selector-regional select {
      min-width: 220px;
      padding: 11px 12px;
      border: 1px solid #c9d3df;
      border-radius: 10px;
      background: white;
      font-size: 1rem;
      color: #23303d;
      outline: none;
    }

    .contenido {
      min-height: 60vh;
      padding: 28px 20px 120px;
      background: white;
    }

    .contenido h2 {
      margin-top: 0;
      margin-bottom: 12px;
      color: var(--azul);
      font-size: clamp(1.4rem, 2vw, 2rem);
    }

    .contenido p {
      max-width: 710px;
      line-height: 1.6;
      color: var(--gris-texto);
      font-size: 1.02rem;
    }

    .boton-asistente {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 1001;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 14px 18px;
      border: none;
      border-radius: 999px;
      background: linear-gradient(135deg, var(--azul), #2f73b6);
      color: #fff;
      cursor: pointer;
      box-shadow: 0 14px 28px rgba(31, 78, 121, 0.35);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      font-size: 0.98rem;
      font-weight: 700;
    }

    .boton-asistente:hover,
    .boton-asistente:focus-visible {
      transform: translateY(-1px);
      box-shadow: 0 18px 32px rgba(31, 78, 121, 0.42);
    }

    .icono-burbuja {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.18);
      font-size: 1.1rem;
    }

    .ventana-asistente {
      position: fixed;
      right: 24px;
      bottom: 92px;
      z-index: 1000;
      display: none;
      width: min(430px, calc(100vw - 24px));
      height: min(720px, calc(100vh - 110px));
      background: white;
      border: 1px solid rgba(153, 166, 180, 0.45);
      border-radius: 22px 22px 18px 18px;
      overflow: hidden;
      box-shadow: var(--sombra);
    }

    .ventana-asistente.abierta {
      display: flex;
      flex-direction: column;
      animation: aparecer 0.22s ease;
    }

    @keyframes aparecer {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.98);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .cabecera-asistente {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: linear-gradient(135deg, var(--azul), #2e6fa4);
      color: white;
      border-bottom: 1px solid rgba(255,255,255,0.18);
    }

    .titulo-chat {
      display: flex;
      align-items: center;
      gap: 10px;
      font-weight: 700;
      letter-spacing: 0.2px;
    }

    .titulo-chat .punto {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--verde);
      box-shadow: 0 0 0 3px rgba(50, 183, 109, 0.2);
    }

    .cerrar-asistente {
      width: 32px;
      height: 32px;
      border: 0;
      border-radius: 50%;
      background: rgba(255,255,255,0.12);
      color: white;
      cursor: pointer;
      font-size: 1.5rem;
      line-height: 1;
    }

    .asistente-iframe {
      flex: 1;
      width: 100%;
      height: 100%;
      border: 0;
      background: #f8fbff;
    }

    .enlace-alternativo {
      display: block;
      padding: 12px 16px;
      background: white;
      color: #0645ad;
      text-align: center;
      text-decoration: none;
      font-weight: 600;
    }

    .enlace-alternativo:hover {
      text-decoration: underline;
    }

    @media (max-width: 600px) {
      .boton-asistente {
        right: 16px;
        bottom: 16px;
        padding: 12px 16px;
      }

      .ventana-asistente {
        right: 12px;
        bottom: 78px;
        width: calc(100vw - 24px);
        height: calc(100vh - 110px);
      }
    }
  </style>
</head>
<body>
  <header>
    <div class="contenedor">
      <h1>PUENTE</h1>
      <div class="subtitulo">Tu asistente de ayuda</div>
    </div>
  </header>

  <main class="contenedor">
    <div class="selector-regional">
      <div>
        <label for="ccaa"><strong>Comunidad Autónoma:</strong></label>
        <select id="ccaa" name="ccaa">
          <option value="age">Ámbito Estatal (AGE)</option>
          <option value="an">Andalucía</option>
          <option value="ct">Cataluña</option>
          <option value="ga">Galicia</option>
          <option value="pv">País Vasco</option>
          <option value="cv">Comunitat Valenciana</option>
        </select>
      </div>

      <div>
        <label for="idioma"><strong>Idioma de atención:</strong></label>
        <select id="idioma" name="idioma">
          <option value="es">Castellano</option>
          <option value="ca">Català / Valencià</option>
          <option value="eu">Euskara</option>
          <option value="gl">Galego</option>
          <option value="en">English</option>
          <option value="fr">Français</option>
          <option value="ar">العربية (Árabe)</option>
        </select>
      </div>
    </div>

    <section class="contenido">
      <h2>Hola, soy PUENTE</h2>
      <p>Estoy aquí para ayudarte con tus dudas, trámites y consultas de la forma más sencilla y cercana posible.</p>
    </section>

    <a
      class="enlace-alternativo"
      href="https://sistema-inclusivo-fsxacs9cxlh7e6tzaf9ax5.streamlit.app"
      target="_blank"
      rel="noopener noreferrer">
      Si el asistente no aparece, abrir PUENTE en una nueva pestaña
    </a>
  </main>

  <section id="ventanaAsistente" class="ventana-asistente" aria-label="Asistente PUENTE">
    <div class="cabecera-asistente">
      <div class="titulo-chat">
        <span class="punto" aria-hidden="true"></span>
        <span>PUENTE</span>
      </div>
      <button id="cerrarAsistente" class="cerrar-asistente" type="button" aria-label="Cerrar asistente">×</button>
    </div>
    <iframe
      class="asistente-iframe"
      src="https://sistema-inclusivo-fsxacs9cxlh7e6tzaf9ax5.streamlit.app"
      title="PUENTE - Tu asistente de ayuda"
      allow="microphone"
      allowfullscreen>
    </iframe>
  </section>

  <button id="botonAsistente" class="boton-asistente" type="button" aria-expanded="false" aria-controls="ventanaAsistente">
    <span class="icono-burbuja">💬</span>
    <span>Hablar con PUENTE</span>
  </button>

  <script>
    const botonAsistente = document.getElementById('botonAsistente');
    const ventanaAsistente = document.getElementById('ventanaAsistente');
    const cerrarAsistente = document.getElementById('cerrarAsistente');

    function alternarAsistente() {
      const abierto = ventanaAsistente.classList.toggle('abierta');
      botonAsistente.setAttribute('aria-expanded', abierto);
      botonAsistente.querySelector('span:last-of-type').textContent = abierto ? 'Cerrar asistente' : 'Hablar con PUENTE';
    }

    botonAsistente.addEventListener('click', alternarAsistente);
    cerrarAsistente.addEventListener('click', alternarAsistente);
  </script>
</body>
</html>
